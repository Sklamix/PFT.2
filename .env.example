# Leave empty to run the Operations Desk on the in-memory mock store.
# Set a Postgres URL and run `prisma db push && prisma db seed` for persistence.
DATABASE_URL=""
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
ADMIN_BOOTSTRAP_PASSWORD="PFT-Admin-Desk!"
RISK_BOOTSTRAP_PASSWORD="PFT-Risk-Desk!"
CRON_SECRET="replace-with-cron-bearer-token"
CRYPTOMUS_MERCHANT_ID=""
CRYPTOMUS_API_KEY=""
NEXT_PUBLIC_FINNHUB_API_KEY=""
# Trading account the /dashboard/terminal page loads (overridable with ?account=<id>).
# Without DATABASE_URL the in-memory engine provides "terminal-demo" (+ "terminal-demo-standby").
NEXT_PUBLIC_TERMINAL_ACCOUNT_ID="terminal-demo"
# NOWPayments crypto checkout (https://nowpayments.io).
NOWPAYMENTS_API_KEY=
# IPN secret from NOWPayments dashboard → Payment settings; verifies x-nowpayments-sig on /api/webhooks/payment-success.
# NOWPAYMENTS_IPN_KEY is accepted as a legacy alias. Required in production.
NOWPAYMENTS_IPN_SECRET=
# Resend transactional email (https://resend.com). Without a key, invoice emails are skipped.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "PFT Challenges <billing@yourdomain.com>".
RESEND_FROM_EMAIL=
# Public base URL used in emailed links (terminal access link). Defaults to the current Vercel deployment.
NEXT_PUBLIC_APP_URL=
# Server name shown on provisioned challenge accounts (default PFT-Demo-Server).
PFT_TRADING_SERVER=
