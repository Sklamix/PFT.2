generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRADER
  ADMIN
  RISK_MANAGER
  SUPPORT
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum ChallengeStatus {
  IN_PROGRESS
  PASSED
  FAILED
}

enum ChallengeType {
  ONE_STEP
  TWO_STEP
  FUNDED
}

enum AccountPhase {
  PHASE_1
  PHASE_2
  FUNDED
}

enum AccountStatus {
  ACTIVE
  FROZEN_STANDBY
  BREACHED
  PASSED
  PASSED_PHASE_1
  PASSED_PHASE_2
  FUNDED
  BREACHED_DAILY
  BREACHED_MAX
  /** Frozen backup that expired because its primary account passed. */
  EXPIRED
  /** Archived instead of hard-deleted so financial history stays immutable. */
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum OrderSide {
  BUY
  SELL
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum PendingTradeOrderStatus {
  PENDING
  FILLED
  CANCELLED
  REJECTED
}

enum PendingOrderType {
  LIMIT
  STOP
  STOP_LIMIT
}

enum CloseReason {
  TAKE_PROFIT
  STOP_LOSS
  MANUAL
  LIQUIDATION_BREACH
}

enum PayoutStatus {
  PENDING
  APPROVED
  DISBURSED
  REJECTED
  MANUALLY_PAID
}

enum WalletNetwork {
  USDT_TRC20
  USDT_ERC20
}

/// Phase 1 Risk Equity rollout state. ENFORCE is reserved for a future,
/// separately authorized phase and must not be assigned by current code.
enum RiskEquityState {
  UNCLASSIFIED
  EXCLUDED
  SHADOW
  ENFORCE
}

enum AppealStatus {
  OPEN
  UPHELD
  OVERTURNED
  WITHDRAWN
}

enum SupportCategory {
  GENERAL
  CHALLENGE
  PAYOUT
  KYC
  ACCOUNT
  TECHNICAL
  RULES
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  WAITING_FOR_STAFF
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportSenderType {
  TRADER
  STAFF
  AI
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  passwordTokenHash      String?   @unique
  passwordTokenExpiresAt DateTime?
  name          String
  nickname      String?
  dateOfBirth   DateTime?
  phone         String?
  country       String?
  avatarUrl     String?
  emailVerifiedAt DateTime?
  profileCompletedAt DateTime?
  role          Role      @default(TRADER)
  kycStatus     KycStatus @default(NOT_STARTED)
  kycSessionId  String?   @unique
  kycVerifiedAt DateTime?
  kycNote       String?
  kycUpdatedAt  DateTime?
  challengeStatus ChallengeStatus @default(IN_PROGRESS)
  favoriteSymbols String[] @default([])
  tokenVersion  Int       @default(0)
  /// Owner-only capability: true only for the trusted platform owner account. No API
  /// may grant or modify this; it is assigned via a one-time reviewed SQL statement.
  canConfirmPayouts Boolean @default(false)
  lastLoginIp   String?
  lastLoginUserAgent String?
  failedLoginCount Int @default(0)
  lastDeviceHash String?
  activeSessionId String?
  /** Last terminal account opened by this trader; restored after navigation and re-login. */
  lastActiveAccountId String?
  riskFlaggedAt DateTime?
  riskFlagReason String?
  /** Last rules version this trader was notified about. */
  rulesNotifiedVersion String?
  /** Country declared for trading from a VPS; logins from elsewhere raise a session alert. */
  declaredVpsCountry String?
  vpsDeclaredAt DateTime?
  telegram      String?
  discord       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /** Verified legal name from KYC, displayed on certificates only after explicit consent. */
  legalName     String?
  /** When the trader consented to show their KYC legal name publicly on certificates. */
  certificateNameConsentAt DateTime?

  /** Platform preferences (Settings → Platform Preferences). */
  interfaceLanguage String @default("en")
  dateFormat        String @default("DD/MM/YYYY")
  numberFormat      String @default("1,234.56")
  /** Display-only currency label. Amounts are always settled in USD. */
  displayCurrency   String @default("USD")
  /** IANA timezone used for displaying timestamps. Stored timestamps stay in UTC. */
  timeZone          String @default("UTC")
  /** Show STOP / STOP-LIMIT in the order ticket. Off by default: limit orders only. */
  advancedOrderTypes Boolean @default(false)
  lastPasswordChangedAt DateTime?
  /// Users with financial history are archived, never hard-deleted.
  archivedAt      DateTime?
  archivedReason  String?
  archivedById    String?

  accounts        TradingAccount[]
  orders          Order[]
  payouts         Payout[]
  certificates    Certificate[]
  auditLogs       AuditLog[] @relation("AuditActor")
  reviewedPayouts Payout[]   @relation("PayoutReviewer")
  paidPayouts     Payout[]   @relation("PayoutPayer")
  approvedPayouts Payout[]   @relation("PayoutApprover")
  appeals         AccountAppeal[] @relation("AppealTrader")
  reviewedAppeals AccountAppeal[] @relation("AppealReviewer")
  accessEvents    AccessEvent[]
  supportTickets  SupportTicket[] @relation("SupportTrader")
  assignedTickets SupportTicket[] @relation("SupportAssignee")
  supportMessages SupportMessage[] @relation("SupportMessageSender")
  aiSupportRequests AiSupportRequest[]
  pushSubscriptions PushSubscription[]
  priceAlerts PriceAlert[]
}

/// One login fingerprint. Used for new-device, country-change and sharing alerts.
model AccessEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  deviceHash String?
  country    String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([deviceHash, createdAt])
}

model EmailLoginCode {
  email      String   @id
  codeHash   String
  expiresAt  DateTime
  sentAt     DateTime
  attempts   Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model TradingAccount {
  id                   String         @id @default(cuid())
  displayId            String         @unique
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mt5Login             String
  mt5Server            String
  /** Optional trader-facing alias shown instead of the system displayId. */
  customName           String?
  planSize             Int
  challengeType        ChallengeType
  phase                AccountPhase
  status               AccountStatus  @default(ACTIVE)
  leverage             String         @default("1:100")
  drawdownMode         String         @default("trailing")
  initialBalance       Decimal        @db.Decimal(14, 2)
  dailyStartingBalance Decimal        @default(0) @db.Decimal(14, 2)
  dailyStartingEquity  Decimal        @db.Decimal(14, 2)
  dailyStartedAt       DateTime?
  currentBalance       Decimal        @db.Decimal(14, 2)
  currentEquity        Decimal        @db.Decimal(14, 2)
  dailyDrawdownPct     Decimal        @db.Decimal(6, 3)
  maxDrawdownPct       Decimal        @db.Decimal(6, 3)
  dailyDrawdownLimitPct Decimal       @db.Decimal(6, 3)
  maxDrawdownLimitPct  Decimal        @db.Decimal(6, 3)
  profitPct            Decimal        @db.Decimal(8, 3)
  tradingDaysCount     Int            @default(0)
  profitSplitPct       Int            @default(80)
  reservedPayoutAmount Decimal        @default(0) @db.Decimal(12, 2)
  breachReason         String?
  frozenAt             DateTime?
  lastTelemetryAt      DateTime?
  balance              Float          @default(0)
  equity               Float          @default(0)
  startingBalance      Float          @default(0)
  peakEquity           Float          @default(0)
  peakEquityDecimal    Decimal?       @db.Decimal(18, 2)
  /// Archived accounts keep every financial record; deletion is disabled by the ledger FK.
  archivedAt           DateTime?
  archivedReason       String?
  archivedById         String?
  /// Set by the risk engine when valuation is unresolved/unverified/stale; blocks risk-increasing actions.
  riskReviewAt         DateTime?
  riskReviewReason     String?
  /// Set while a payout provider execution is in flight; blocks new/increased exposure (risk reduction stays allowed).
  payoutExecutionAt    DateTime?
  /// Two-phase inactivity closure claim. While set, new payout requests are refused so a
  /// closure can never race an irreversible position close. A stale claim is recoverable.
  inactivityClosureClaimedAt DateTime?
  inactivityClosureClaimedBy String?
  /// Monotonic fencing generation; each successful claim increments it so an old
  /// worker can never finalize a workflow it no longer owns.
  inactivityClosureGeneration Int @default(0)
  /// Lease deadline extended by heartbeat while the owning worker is alive.
  inactivityClosureLeaseUntil DateTime?
  maxDailyLoss         Float          @default(0.05)
  maxTrailingDrawdown  Float          @default(0.10)
  profitTarget         Float          @default(0.10)
  isFrozenBackup       Boolean        @default(false)
  /** Primary account this frozen backup belongs to; activates when that primary breaches. */
  backupForAccountId   String?
  resetSourceAccountId String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  orders        Order[]
  trades        Trade[]
  payouts       Payout[]
  auditLogs     AuditLog[]
  positions     Position[]
  tradeHistory  TradeHistory[]
  pendingTradeOrders PendingTradeOrder[]
  ledgerEntries AccountLedgerEntry[]
  ledgerBaselines AccountLedgerBaseline[]
  appeals       AccountAppeal[]
  certificates  Certificate[]
  breachEvents  AccountBreachEvent[]

  /// Phase 1 Risk Equity rollout state. Existing accounts default to UNCLASSIFIED
  /// and are never promoted automatically.
  riskEquityState          RiskEquityState @default(UNCLASSIFIED)
  riskEquityStateReason    String?
  riskEquityStateChangedAt DateTime         @default(now())
  riskEquityBaseline       RiskEquityBaseline?
  riskEquityShadowEvaluations RiskEquityShadowEvaluation[]

  @@index([status])
  @@index([riskEquityState])
  @@index([mt5Login])
  @@index([userId])
  @@index([backupForAccountId])
  @@index([archivedAt])
  @@index([riskReviewAt])
  @@index([inactivityClosureClaimedAt])
}

/// Immutable starting point for the Phase 1 Risk Equity shadow model. One row per
/// account; it is written once during account provisioning and never overwritten.
model RiskEquityBaseline {
  id                 String   @id @default(cuid())
  accountId          String   @unique
  account            TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  modelVersion       String
  source             String
  accountStatus      String
  initialBalance     Decimal  @db.Decimal(14, 2)
  startingBalance    Decimal  @db.Decimal(14, 2)
  balance            Decimal  @db.Decimal(18, 2)
  equity             Decimal  @db.Decimal(18, 2)
  peakEquity         Decimal  @db.Decimal(18, 2)
  dailyStartingEquity Decimal @db.Decimal(18, 2)
  dailyStartedAt     DateTime?
  capturedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  evaluations RiskEquityShadowEvaluation[]

  @@index([capturedAt])
}

/// Read-only shadow result for one account snapshot. This table is evidence only:
/// it never changes balances, equity, payouts, ledger entries or account status.
model RiskEquityShadowEvaluation {
  id                      String   @id @default(cuid())
  accountId               String
  account                 TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  baselineId              String?
  baseline                RiskEquityBaseline? @relation(fields: [baselineId], references: [id], onDelete: SetNull)
  modelVersion            String
  evaluatedAt             DateTime @default(now())
  balance                 Decimal  @db.Decimal(18, 2)
  equity                  Decimal  @db.Decimal(18, 2)
  riskEquity              Decimal  @db.Decimal(18, 2)
  reservedAddBack         Decimal  @db.Decimal(18, 2) @default(0)
  paidAddBack             Decimal  @db.Decimal(18, 2) @default(0)
  dailyStartingRiskEquity Decimal? @db.Decimal(18, 2)
  dailyLoss               Decimal? @db.Decimal(18, 2)
  dailyLimit              Decimal? @db.Decimal(18, 2)
  trailingPeak            Decimal? @db.Decimal(18, 2)
  trailingFloor           Decimal? @db.Decimal(18, 2)
  trailingDrawdown        Decimal? @db.Decimal(18, 2)
  hypotheticalBreach      String?
  hypotheticalReason      String?
  existingStatus          String?
  existingBreachReason    String?
  comparison              String?
  dataQuality             Json?
  skippedReason           String?
  inputHash               String
  createdAt               DateTime @default(now())

  @@unique([accountId, inputHash])
  @@index([accountId, evaluatedAt])
  @@index([hypotheticalBreach])
  @@index([skippedReason])
}

/// Canonical record of when a rule breach actually occurred, separately from when the
/// system detected it. Payout protection compares `occurredAt` with `Payout.requestedAt`.
/// `requiresManualReview` means no trustworthy `occurredAt` source exists; such a row must
/// never be used for automatic payout cancellation.
model AccountBreachEvent {
  id                   String        @id @default(cuid())
  accountId            String
  account              TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind                 String
  /// Actual event time. Null when no reliable source exists.
  occurredAt           DateTime?
  /// When this system first observed / recorded the breach.
  detectedAt           DateTime
  /// Producer that created the event (ENGINE, ENFORCEMENT, ADMIN, OVERNIGHT, INACTIVITY, ...).
  source               String
  /// Which timestamp supplied occurredAt (VALUATION_QUOTE, NEWS_EVENT, SESSION_CUTOFF, ...).
  timeSource           String?
  requiresManualReview Boolean       @default(false)
  /// Deterministic key so repeated enforcement of the same breach does not duplicate the event.
  dedupeKey            String        @unique
  auditLogId           String?       @unique
  auditLog             AuditLog?     @relation(fields: [auditLogId], references: [id], onDelete: SetNull)
  payload              Json?
  createdAt            DateTime      @default(now())

  @@index([accountId, occurredAt])
  @@index([accountId, detectedAt])
  @@index([kind])
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String?
  account          TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  provider         String      @default("cryptomus")
  providerOrderId  String      @unique
  /** Checkout intent that produced this order (D7 dedupe/conflict detection). */
  checkoutIntentKey String?
  amount           Decimal     @db.Decimal(12, 2)
  currency         String      @default("USD")
  status           OrderStatus @default(PENDING)
  /** Rulebook version accepted when the order was created. */
  rulesVersion     String?
  rawPayload       Json?
  paymentUrl          String?
  providerInvoiceId   String?
  invoiceEmailStatus  EmailDeliveryStatus?
  invoiceEmailSentAt  DateTime?
  invoiceEmailError   String?
  provisionedAt           DateTime?
  credentialsEmailStatus  EmailDeliveryStatus?
  credentialsEmailSentAt  DateTime?
  credentialsEmailError   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  paymentRecovery PaymentRecovery?

  @@index([status])
  @@index([checkoutIntentKey])
}

/// One active (or last completed) checkout intent per customer identity + product.
/// The unique `key` is the database-level dedupe guarantee behind D7.
enum CheckoutIntentStatus {
  CREATING
  READY
  FAILED
}

model CheckoutIntent {
  id         String               @id @default(cuid())
  key        String               @unique
  email      String
  userId     String?
  orderId    String?
  status     CheckoutIntentStatus @default(CREATING)
  paymentUrl String?
  attempts   Int                  @default(0)
  expiresAt  DateTime
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status, expiresAt])
  @@index([orderId])
}

/// Paid-order provisioning recovery queue (D5). The order itself stays PAID; this row
/// tracks why provisioning is incomplete and what the owner may do next.
enum PaymentRecoveryStatus {
  OPEN
  RETRYING
  MANUAL_REVIEW
  REFUND_REVIEW
  RESOLVED
}

model PaymentRecovery {
  id                String                @id @default(cuid())
  orderId           String                @unique
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            PaymentRecoveryStatus @default(OPEN)
  reason            String?
  errorCode         String?
  attempts          Int                   @default(0)
  maxAttempts       Int                   @default(5)
  nextAttemptAt     DateTime?
  lastAttemptAt     DateTime?
  lastError         String?
  resolvedAccountId String?
  updatedBy         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, nextAttemptAt])
}

model Trade {
  id                    String      @id @default(cuid())
  accountId             String
  account               TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticket                String
  symbol                String
  lots                  Decimal     @db.Decimal(10, 2)
  side                  TradeSide
  openPrice             Decimal     @db.Decimal(14, 5)
  closePrice            Decimal?    @db.Decimal(14, 5)
  openTime              DateTime
  closeTime             DateTime?
  profit                Decimal     @db.Decimal(12, 2)
  swap                  Decimal     @db.Decimal(12, 2) @default(0)
  commission            Decimal     @db.Decimal(12, 2) @default(0)
  status                TradeStatus @default(OPEN)
  markedForLiquidation  Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([accountId, status])
  @@unique([accountId, ticket])
}

model Position {
  id               String         @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  symbol           String
  side             OrderSide
  sizeLots         Float
  entryPrice       Float
  currentPrice     Float
  stopLoss         Float?
  takeProfit       Float?
  floatingPnl      Float          @default(0)
  status           PositionStatus @default(OPEN)
  openedAt         DateTime       @default(now())
  closedAt         DateTime?

  /// Financial snapshot captured at entry. Null only for legacy positions opened before Phase 2.
  originalLots            Float     @default(0)
  remainingLots           Float?
  closedLots              Float     @default(0)
  contractSizeSnapshot    Decimal?  @db.Decimal(18, 4)
  quoteCurrencySnapshot   String?
  instrumentLeverage      Int?
  commissionPlanId        String?
  commissionModel         CommissionModel?
  entryRateSnapshot       Decimal?  @db.Decimal(18, 8)
  exitRateSnapshot        Decimal?  @db.Decimal(18, 8)
  minFeeSnapshot          Decimal?  @db.Decimal(12, 2)
  maxFeeSnapshot          Decimal?  @db.Decimal(12, 2)
  entryCommission         Decimal?  @db.Decimal(18, 2)
  entryCommissionCurrency String?
  /// Cumulative entry commission already allocated to partial closes. Keeps rounding residual exact.
  allocatedEntryCommission Decimal? @db.Decimal(18, 2)
  entryFxRate             Decimal?  @db.Decimal(18, 10)
  entryFxTimestamp        DateTime?
  commissionSource        String?
  /// Last valuation state computed by the risk engine (RESOLVED_CURRENT, RESOLVED_ENTRY_RATE, STALE, UNRESOLVED, UNVERIFIED_SPEC).
  valuationStatus         String?
  idempotencyKey          String?

  @@index([tradingAccountId, status])
  @@unique([tradingAccountId, idempotencyKey])
}

model PendingTradeOrder {
  id               String                  @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount          @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  symbol           String
  side             OrderSide
  type             PendingOrderType        @default(LIMIT)
  sizeLots         Float
  limitPrice       Float
  stopPrice        Float?
  triggeredAt      DateTime?
  stopLoss         Float?
  takeProfit       Float?
  status           PendingTradeOrderStatus @default(PENDING)
  reason           String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  filledAt         DateTime?
  cancelledAt      DateTime?
  idempotencyKey   String?
  instrumentLeverage Int?
  contractSizeSnapshot Decimal? @db.Decimal(18, 4)
  quoteCurrencySnapshot String?

  @@index([tradingAccountId, status, createdAt])
  @@index([status, createdAt])
  @@unique([tradingAccountId, idempotencyKey])
}

model TradeHistory {
  id               String         @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  symbol           String
  side             OrderSide
  sizeLots         Float
  entryPrice       Float
  exitPrice        Float
  /// Net realised PnL for the executed quantity (entry commission allocated + exit commission deducted).
  /// Historical rows predate commissions and remain gross.
  pnl              Float
  originalPnl      Float?
  voidedAt         DateTime?
  voidReason       String?
  closeReason      CloseReason
  openedAt         DateTime
  closedAt         DateTime       @default(now())
  journal          JournalEntry?

  /// Phase 2 financial breakdown. Null on legacy rows = unknown, never "zero".
  positionId       String?
  grossPnl         Float?
  entryCommission  Decimal?  @db.Decimal(18, 2)
  exitCommission   Decimal?  @db.Decimal(18, 2)
  totalCommission  Decimal?  @db.Decimal(18, 2)
  netPnl           Decimal?  @db.Decimal(18, 2)
  closedLots       Float?
  remainingLots    Float?
  fxRate           Decimal?  @db.Decimal(18, 10)
  fxTimestamp      DateTime?
  fxSource         String?
  fxStale          Boolean?  @default(false)
  fxUnresolved     Boolean?  @default(false)
  /// GROSS_LEGACY | NET | UNRESOLVED | STALE | VOID. Null only for historical rows.
  pnlBasis         String?
  /// Last valuation state at close (RESOLVED_CURRENT, RESOLVED_ENTRY_RATE, STALE, UNRESOLVED, UNVERIFIED_SPEC).
  valuationStatus  String?
  idempotencyKey   String?

  /// Void audit trail. Voiding never destroys the original financial evidence.
  originalGrossPnl     Float?
  originalNetPnl       Decimal? @db.Decimal(18, 2)
  originalFxRate       Decimal? @db.Decimal(18, 10)
  originalFxSource     String?
  originalFxStale      Boolean?
  originalFxUnresolved Boolean?
  voidedById           String?
  voidedByKind         String?
  voidSynthetic        Boolean  @default(false)

  /// Execution price provenance for controlled stale-quote closes.
  priceSource    String?
  priceTimestamp DateTime?
  priceStale     Boolean?

  @@index([tradingAccountId, closedAt])
  @@index([positionId])
  @@unique([tradingAccountId, idempotencyKey])
}

/// Reflective journal records attached to closed trades: notes, strategy tags and
/// an optional chart screenshot (stored as a small data URL).
model JournalEntry {
  id         String        @id @default(cuid())
  tradeId    String        @unique
  trade      TradeHistory  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  userId     String
  note       String        @default("")
  tags       String        @default("[]")
  screenshot String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId, updatedAt])
}

model Payout {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String
  account          TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount           Decimal        @db.Decimal(12, 2)
  profitSplitPct   Int            @default(80)
  walletAddress    String
  network          WalletNetwork
  status           PayoutStatus   @default(PENDING)
  balanceReserved  Boolean        @default(false)
  /// Scoped Idempotency-Key for the payout request; unique per user.
  requestKey       String?
  providerBatchId  String?
  providerPayoutId String?        @unique
  providerStatus   String?
  /// Explicit provenance marker: MANUAL_V1 (new payouts, owner-confirmed off-platform)
  /// or EXECUTION_V1 (legacy provider workflow) or LEGACY_MANUAL_APPROVAL (disabled).
  executionPolicy  String?
  /// Durable execution state machine. Null until a worker atomically claims execution.
  executionState   String?
  /// Stable execution idempotency key (`exec:<payoutId>`); also the provider unique_external_id base.
  executionKey     String?        @unique
  executionClaimedAt DateTime?
  /// Unique owner token for the current execution attempt.
  executionClaimedBy String?
  /// Lease expiry for the current owner. Expiry never authorizes a blind create retry.
  executionLeaseUntil DateTime?
  /// SHA-256 fingerprint of amount/network/address/account captured at claim time.
  executionSnapshotHash String?
  txHash           String?
  rejectReason     String?
  /// Set when a manual rejection forfeits the reserve on a terminal account
  /// (ARCHIVED/EXPIRED or archivedAt != null). Null for a normal reserve release.
  forfeitedAt      DateTime?
  /// Application-level source of the cancellation/reserve outcome, e.g.
  /// `ACCOUNT_CLOSED_FORFEITURE`. Null for a plain reserve release.
  cancelSource     String?
  requestedAt      DateTime       @default(now())
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedBy       User?          @relation("PayoutReviewer", fields: [reviewedById], references: [id])
  certificates    Certificate[]
  legacyCutoverEvidence PayoutLegacyCutoverEvidence?
  /// Manual payout (MANUAL_V1) fields. transactionRef is the unique external payment
  /// reference supplied by the owner when confirming an actual transfer.
  paidAmount       Decimal?       @db.Decimal(12, 2)
  paidCurrency     String?
  paidAt           DateTime?
  paymentMethod    String?
  transactionRef   String?        @unique
  paidById         String?
  paidBy           User?          @relation("PayoutPayer", fields: [paidById], references: [id])
  approvedById     String?
  approvedBy       User?          @relation("PayoutApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@unique([userId, requestKey])
}

/// Reserved schema for a future trusted two-administrator legacy cutover workflow.
/// Legacy marking and legacy approval are currently DISABLED: `executionPolicy` is
/// immutable once written, and no application/API or DB function creates rows in this
/// table. A future workflow must introduce a real privileged role and authenticated
/// requester/verifier identity before this table can be populated.
model PayoutLegacyCutoverEvidence {
  payoutId          String   @id
  payout            Payout   @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  evidenceReference String
  evidenceHash      String   @unique
  requestedBy       String
  verifiedBy        String
  requestedAt       DateTime
  verifiedAt        DateTime
}

/// Appeal against a breach decision. Traders file it inside the appeal window and an
/// admin who did not execute the breach decides it.
model AccountAppeal {
  id           String        @id @default(cuid())
  accountId    String
  account      TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation("AppealTrader", fields: [userId], references: [id], onDelete: Cascade)
  status       AppealStatus  @default(OPEN)
  breachKind   String?
  breachReason String?
  reason       String
  decisionNote String?
  decidedById  String?
  decidedBy    User?         @relation("AppealReviewer", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([accountId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  accountId String?
  account   TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  breachEvent AccountBreachEvent?

  @@index([createdAt])
}

/// Internal broadcast messages from admins to staff, filterable by role class.
model AdminMessage {
  id            String   @id @default(cuid())
  subject       String
  body          String
  audience      String   @default("ALL")
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([audience])
}

/// Two-way trader ↔ staff support conversation. `publicId` is the stable,
/// unguessable reference used in URLs; internal ids stay server-side.
model SupportTicket {
  id           String          @id @default(cuid())
  publicId     String          @unique
  userId       String
  user         User            @relation("SupportTrader", fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  category     SupportCategory @default(GENERAL)
  status       SupportStatus   @default(OPEN)
  priority     SupportPriority @default(NORMAL)
  assignedToId String?
  assignedTo   User?           @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resolvedAt   DateTime?
  closedAt     DateTime?
  messages     SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([updatedAt])
}

/// One message inside a support ticket. `senderUserId` is intentionally
/// `SetNull` on delete so removing a staff member never erases history.
model SupportMessage {
  id             String            @id @default(cuid())
  ticketId       String
  ticket         SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType     SupportSenderType
  senderUserId   String?
  senderUser     User?             @relation("SupportMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  body           String
  /// Reserved for future AI answers (sources, confidence). Never used for money/status changes.
  metadata       Json?
  /// Optional client key; (ticketId, idempotencyKey) is unique so retries do not duplicate messages.
  idempotencyKey String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([ticketId, idempotencyKey])
  @@index([ticketId, createdAt])
}

/// Durable request claims and results for cross-instance AI chat idempotency.
model AiSupportRequest {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash        String   @db.Char(64)
  requestHash    String   @db.Char(64)
  status         String   @default("IN_PROGRESS")
  result         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?
  expiresAt      DateTime?

  @@unique([userId, keyHash])
  @@index([expiresAt])
}

/// Durable idempotency records for signed inbound webhooks.
model WebhookEvent {
  id         String   @id
  provider   String
  eventType  String
  receivedAt DateTime @default(now())

  @@index([provider, receivedAt])
}

model TelemetrySync {
  id             String   @id @default("global")
  lastSyncedAt   DateTime?
  lastStatus     String?
  lastError      String?
  recordsUpdated Int      @default(0)
  inProgress     Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model MarketQuote {
  symbol       String   @id
  mid          Decimal  @default(0) @db.Decimal(18, 9)
  bid          Decimal  @db.Decimal(18, 9)
  ask          Decimal  @db.Decimal(18, 9)
  spreadType   String   @default("SYNTHETIC")
  source       String   @default("TWELVE_DATA")
  providerTime DateTime
  updatedAt    DateTime @updatedAt

  @@index([providerTime])
}

/// A chart-created price threshold. Evaluated by a cron against live quotes; the
/// owner is emailed once, when the price crosses it.
model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  /// ABOVE | BELOW — the side the price has to cross.
  direction   String
  price       Decimal   @db.Decimal(18, 5)
  /// ACTIVE | TRIGGERED | CANCELLED
  status      String    @default("ACTIVE")
  /// Last quote the evaluator saw, kept for the email and for support.
  lastPrice   Decimal?  @db.Decimal(18, 5)
  /// Delivery attempts. Capped at 3 so a broken mailer cannot loop forever.
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  triggeredAt DateTime?
  notifiedAt  DateTime?

  @@index([status, symbol])
  @@index([userId, status])
}

/// Public payout feed shown on the marketing site. The existing `Payout` model
/// remains the source of truth for trader payout requests and disbursements.
model PayoutProof {
  id             String   @id @default(cuid())
  traderName     String
  countryCode    String   @db.VarChar(2)
  accountSize    Decimal  @db.Decimal(14, 2)
  payoutAmount   Decimal  @db.Decimal(14, 2)
  payoutMethod   String
  sourcePayoutId String?  @unique
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

/// Public trading conditions shown on the marketing homepage and managed from
/// the operations desk. A future liquidity-bridge sync can update these rows.
model TradingInstrument {
  id               String   @id @default(cuid())
  symbol           String   @unique
  /// Canonical terminal symbol (EURUSD, US100). Nullable until the registry seed runs.
  terminalSymbol   String?  @unique
  avgSpread        Decimal  @db.Decimal(10, 3)
  /// Legacy per-lot rate kept for compatibility; versioned tariffs will live in CommissionPlan.
  commissionPerLot Decimal  @db.Decimal(10, 2)
  /// False means no tariff has been configured yet, so the instrument must not open positions.
  commissionConfigured Boolean @default(false)
  /// Explicit operator approval for an intentionally free instrument. Without it a zero rate fails closed.
  zeroFeeApproved  Boolean  @default(false)
  category         String
  contractSize     Decimal? @db.Decimal(18, 4)
  minLots          Decimal? @db.Decimal(10, 4)
  lotStep          Decimal? @db.Decimal(10, 4)
  maxLots          Decimal? @db.Decimal(10, 4)
  tickSize         Decimal? @db.Decimal(18, 8)
  quoteCurrency    String?
  profitCurrency   String?
  leverage         Int?
  conversionMode   String?
  specSource       String?
  /// Legacy aggregate flag; superseded by specVerification. Kept for compatibility.
  specVerified     Boolean? @default(false)
  /// Per-field verification metadata (status/source/confirmedAt/confirmedBy). Additive; nullable.
  specVerification Json?
  isActive         Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  spreadSamples TradingSpreadSample[]
  commissionPlans CommissionPlan[]

  @@index([isActive, category])
}

enum CommissionModel {
  PER_LOT
  PER_DEAL
  PERCENT_NOTIONAL
}

/// Immutable, versioned tariff for one instrument. A new version is created on change;
/// old rows stay untouched so open positions keep their snapshot.
model CommissionPlan {
  id            String           @id @default(cuid())
  instrumentId  String
  instrument    TradingInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  model         CommissionModel
  entryRate     Decimal          @db.Decimal(18, 8)
  exitRate      Decimal          @db.Decimal(18, 8)
  currency      String           @default("USD")
  minFee        Decimal?         @db.Decimal(12, 2)
  maxFee        Decimal?         @db.Decimal(12, 2)
  effectiveFrom DateTime         @default(now())
  isActive      Boolean          @default(true)
  /// Explicit approval for a deliberately free tariff (entry and exit rates of zero).
  zeroFeeApproved Boolean        @default(false)
  source        String?
  createdBy     String?
  createdAt     DateTime         @default(now())

  @@index([instrumentId, isActive, effectiveFrom])
}

/// Immutable opening-balance marker for accounts whose history predates the ledger.
/// Creating a baseline never changes the account balance.
model AccountLedgerBaseline {
  id                   String    @id @default(cuid())
  accountId            String
  account              TradingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount               Decimal   @db.Decimal(18, 2)
  currency             String    @default("USD")
  capturedAt           DateTime  @default(now())
  /** Deterministic ledger watermark (D9): entries after this cursor are post-baseline. */
  ledgerWatermarkAt    DateTime?
  ledgerWatermarkId    String?
  source               String
  version              Int       @default(1)
  historyComplete      Boolean   @default(false)
  reconciliationStatus String    @default("BASELINED")
  sourceReference      String?
  createdBy            String?
  createdAt            DateTime  @default(now())

  @@unique([accountId, version])
  @@index([accountId, capturedAt])
}

enum LedgerEntryType {
  TRADE_PNL
  ENTRY_COMMISSION
  EXIT_COMMISSION
  SWAP
  ADJUSTMENT
  REVERSAL
  RECONCILIATION
  PAYOUT_RESERVE
  PAYOUT_RELEASE
}

/// Append-only double-entry-style account ledger. `amount` is signed (debit negative).
model AccountLedgerEntry {
  id             String          @id @default(cuid())
  accountId      String
  account        TradingAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type           LedgerEntryType
  amount         Decimal         @db.Decimal(18, 2)
  currency       String          @default("USD")
  balanceAfter   Decimal         @db.Decimal(18, 2)
  refType        String?
  refId          String?
  positionId     String?
  executionId    String?
  idempotencyKey String
  metadata       Json?
  createdAt      DateTime        @default(now())

  @@unique([accountId, idempotencyKey])
  @@index([accountId, createdAt])
  @@index([type, createdAt])
  @@index([positionId])
}

/// Lifecycle of an FX reconciliation record. VOIDED is terminal and can never be resolved.
enum FxReconciliationStatus {
  UNRESOLVED
  RESOLVED
  VOIDED
}

/// Queue for closes whose quote currency could not be converted to USD at a
/// verified rate. `appliedAmountUsd` records the amount already reflected in the
/// balance (entry-rate fallback) so a later resolution applies only the delta.
model FxReconciliation {
  id             String    @id @default(cuid())
  accountId      String
  positionId     String?
  tradeHistoryId String?
  quoteCurrency  String
  amountQuote    Decimal   @db.Decimal(18, 8)
  status         FxReconciliationStatus @default(UNRESOLVED)
  reason         String?
  /// USD gross PnL already booked at close (entry-rate fallback); zero for a fully unresolved close.
  appliedAmountUsd Decimal @default(0) @db.Decimal(18, 2)
  appliedRate    Decimal?  @db.Decimal(18, 10)
  resolutionRate Decimal?  @db.Decimal(18, 10)
  ratePair       String?
  rateTimestamp  DateTime?
  rateSource     String?
  resolutionVersion Int?
  resolutionNote String?
  voidedAt       DateTime?
  voidReason     String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([accountId])
  @@unique([tradeHistoryId])
}

/// Raw live-spread samples used to maintain the rolling 24h average.
model TradingSpreadSample {
  id           String            @id @default(cuid())
  instrumentId String
  instrument   TradingInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  spread       Decimal           @db.Decimal(18, 8)
  sampledAt    DateTime          @default(now())

  @@index([instrumentId, sampledAt])
  @@index([sampledAt])
}

/// Economic-calendar releases synced from the public weekly calendar feed.
model EconomicEvent {
  id         String   @id @default(cuid())
  time       DateTime
  title      String
  impact     String
  isTradable Boolean  @default(true)
  country    String
  externalId String?  @unique
  forecast   String?
  previous   String?
  actual     String?
  updatedAt  DateTime @updatedAt

  @@index([time])
  @@index([impact, time])
}

/// Singleton row (`id = "global"`) with operational execution metrics.
model SystemMetrics {
  id                  String   @id @default("global")
  avgExecutionSpeedMs Int      @default(28)
  lastUpdated         DateTime @default(now())

  @@map("SystemMetrics")
}

/// Singleton row (`id = "global"`) with the public marketing counters.
model PlatformStats {
  id                  String   @id @default("global")
  totalRewardsPaid    Decimal  @default(0) @db.Decimal(16, 2)
  fundedTradersCount  Int      @default(0)
  avgPayoutTimeHours  Float    @default(0)
  countriesServedCount Int     @default(0)
  lastUpdatedAt       DateTime @default(now())

  @@map("PlatformStats")
}

model ChallengePricing {
  id            String   @id @default(cuid())
  accountSize   Int
  challengeType String   @default("2-STEP")
  dailyLossType Int
  price         Int
  updatedAt     DateTime @updatedAt

  @@unique([accountSize, challengeType, dailyLossType])
}

/// Public trader achievement certificate with a personalizable, shareable design.
/// Issued idempotently from authoritative events (phase completion, funded
/// activation, confirmed payout) via a unique (userId, type, eventKey) key.
model Certificate {
  id              String    @id @default(cuid())
  publicId        String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PHASE_1 | PHASE_2 | FUNDED | PAYOUT
  type            String
  /// Stable reference to the achievement event (accountId or payoutId) for idempotent issuance.
  eventKey        String
  accountId       String?
  account         TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payoutId        String?
  payout          Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  /// VERIFIED | REVOKED
  status          String    @default("VERIFIED")
  revokedAt       DateTime?
  revokeReason    String?
  revokedById     String?
  /// GOLD | SILVER | NEBULA
  theme           String    @default("GOLD")
  /// Approved emoji symbol, or null when hidden.
  symbol          String?   @default("🪐")
  /// PROFILE | KYC
  displayNameMode String    @default("PROFILE")
  /// Payout certificates only: whether to show the confirmed amount publicly.
  showAmount      Boolean   @default(true)
  issuedAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, type, eventKey])
  @@index([userId])
  @@index([status])
  /// Public payout feed resolves a proof's certificate through this column.
  @@index([payoutId])
}

/// Aggregated from live spot ticks recorded by the server. One row per minute per symbol;
/// 5m/15m/1h candles are built by aggregating these rows at read time. The physical table keeps
/// its original name so existing deployments need no migration.
model MarketCandle {
  id        String   @id @default(cuid())
  symbol    String   @default("XAUUSD")
  minute    DateTime @db.Timestamptz(3)
  open      Float
  high      Float
  low       Float
  close     Float
  samples   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("GoldCandle")
  @@unique([symbol, minute])
  @@index([symbol, minute])
}

/// Durable fixed-window rate-limit buckets (login brute-force, email-code, etc.).
/// Keys are caller-defined; expired rows are pruned by the trading cron.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

/// First-party marketing analytics. Anonymous by construction: no IP, no user
/// agent, no user id. `sessionId` is a random per-tab string from sessionStorage
/// and identifies a tab, never a person. Rows are pruned by the trading cron
/// once they are older than the retention window.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  props     Json?
  path      String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Operational Observability (Phase 1.7.0)
//
// Heartbeat/execution/incident models for the System Health subsystem. These
// tables are strictly operational: they never reference financial entities
// (Payout, AccountLedgerEntry, TradingAccount) and never mutate balance, equity,
// reserve, ledger, breach or account status. See docs in lib/ops/observability.ts.
// ---------------------------------------------------------------------------

enum ComponentGroup {
  SCHEDULER
  VERCEL
  WORKER
  MARKET_DATA
  DATABASE
  RISK_ENGINE
  EMAIL
}

enum ComponentKind {
  SCHEDULER
  APP
  WORKER
  JOB
  PROVIDER
}

enum LivenessState {
  HEALTHY
  STALE
  FAILED
  UNKNOWN
}

enum ExecutionState {
  STARTED
  RUNNING
  SUCCEEDED
  PARTIAL_SUCCESS
  FAILED
  TIMED_OUT
}

enum IncidentType {
  HEARTBEAT_STALE
  PROCESS_FAILED
  PROCESS_TIMED_OUT
  MARKET_STALE
  MARKET_CONNECTION_FAILED
  DB_UNAVAILABLE
  EMAIL_DOWN
  BATCH_PARTIAL_FAILURE
  PROVIDER_FALLBACK_BROKEN
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  SUPPRESSED
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// Registry of monitored components. One row per physical service / worker / job.
model SystemComponent {
  key                   String         @id
  group                 ComponentGroup
  kind                  ComponentKind
  label                 String
  /// Expected heartbeat interval in milliseconds (drives stale/failure thresholds).
  expectedMs            Int
  enabled               Boolean        @default(true)

  heartbeat  SystemHeartbeat?
  executions SystemExecution[]
  incidents  SystemHealthIncident[]

  @@map("SystemComponent")
}

/// Current liveness state per component (1 row per component, upserted in place).
/// `lastSuccessfulAt` is never updated by a failed attempt; `lastMeta` holds only
/// aggregated counters — never account ids or personal data.
model SystemHeartbeat {
  componentKey     String         @id
  component        SystemComponent @relation(fields: [componentKey], references: [key], onDelete: Cascade)
  liveness         LivenessState  @default(UNKNOWN)
  lastStartedAt    DateTime?
  lastAttemptAt    DateTime?
  lastSuccessfulAt DateTime?
  lastFailedAt     DateTime?
  leaseExpiresAt   DateTime?
  /// Current execution run id; used to discard late writes from superseded runs.
  runId            String?
  lastError        String?
  lastErrorCount   Int            @default(0)
  lastMeta         Json?
  updatedAt        DateTime       @updatedAt

  @@map("SystemHeartbeat")
}

/// One scheduled execution slot. `scheduledSlotKey` deduplicates the scheduled
/// slot (not the run); `runId` identifies a concrete run for lease takeover.
model SystemExecution {
  id               String         @id @default(cuid())
  componentKey     String
  component        SystemComponent @relation(fields: [componentKey], references: [key], onDelete: Cascade)
  scheduledSlotKey String
  runId            String
  state            ExecutionState @default(STARTED)
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?
  leaseExpiresAt   DateTime?
  /// Aggregated counters only (`{ checked, ok, failed, skipped }`), no account ids.
  summary          Json?
  error            String?

  @@unique([componentKey, scheduledSlotKey])
  @@index([componentKey, startedAt])
  @@index([runId])
  /// Health-evaluator latest-terminal-state candidate queries (Phase 1.8.1, q1–q3).
  @@index([componentKey, state, finishedAt, scheduledSlotKey])
  /// q4 (TIMED_OUT candidates are ordered by lease expiry, not finishedAt).
  @@index([componentKey, state, leaseExpiresAt, scheduledSlotKey])

  @@map("SystemExecution")
}

/// Incident history. `activeKey` is non-null while OPEN/ACKNOWLEDGED/SUPPRESSED and
/// is set to NULL on RESOLVED, so a future incident of the same type can be created
/// without colliding with history (PostgreSQL treats NULLs as distinct under UNIQUE).
model SystemHealthIncident {
  id                String          @id @default(cuid())
  incidentType      IncidentType
  componentKey      String
  component         SystemComponent @relation(fields: [componentKey], references: [key], onDelete: Cascade)
  /// Non-null while active; NULL once RESOLVED (frees the unique slot).
  activeKey         String?         @unique
  severity          IncidentSeverity
  status            IncidentStatus  @default(OPEN)
  /// Time the underlying failure actually occurred (event time, not processing time).
  occurredAt        DateTime        @default(now())
  openedAt          DateTime        @default(now())
  lastOccurredAt    DateTime        @default(now())
  acknowledgedAt    DateTime?
  acknowledgedBy    String?
  resolvedAt        DateTime?
  resolvedBy        String?
  suppressedAt      DateTime?
  suppressionReason String?
  occurrenceCount   Int             @default(1)
  title             String
  detail            String?

  @@index([componentKey, status])
  @@index([openedAt])

  @@map("SystemHealthIncident")
}

/// Per-pair recovery watermark `(componentKey, incidentType)`. Keeps event
/// ordering isolated per incident type: recovering TYPE_A must not suppress a
/// later failure of TYPE_B on the same component.
model SystemIncidentWatermark {
  componentKey           String
  incidentType           IncidentType
  lastResolvedOccurredAt DateTime
  /// Opaque composite ordering key `pad(timeMs,15)|recoveryBit|scheduledSlotKey`
  /// (Phase 1.8.1.10–1.8.1.12). NULL for legacy rows: they use the timestamp-only
  /// guard until the first strictly newer resolution converts them. The column is
  /// created with `COLLATE "C"` (see prisma/sql/observability-watermark-key.sql)
  /// so SQL ordering matches the TypeScript code-unit ordering of the ASCII key.
  /// Never parsed — compared as an opaque string only.
  lastResolvedOrderKey   String?
  updatedAt              DateTime        @updatedAt

  @@id([componentKey, incidentType])
  @@map("SystemIncidentWatermark")
}

/// Kind of a recorded incident event. Recovery events are deduplicated separately
/// from failure events, so a failure and a recovery can never collide on the same
/// id, and a re-delivered recovery cannot close a newer incident.
enum IncidentEventKind {
  FAILURE
  RECOVERY
}

/// Durable deduplication ledger for incident events. The unique
/// `(componentKey, incidentType, eventKind, eventId)` key guarantees a given
/// event id is processed exactly once, even when re-delivered non-consecutively
/// (A → B → A) or concurrently. Sources without a natural event id fall back to a
/// deterministic derived id (see lib/ops/observability.ts).
model SystemIncidentEvent {
  id           String            @id @default(cuid())
  componentKey String
  incidentType IncidentType
  eventKind    IncidentEventKind
  eventId      String
  incidentId   String?
  processedAt  DateTime          @default(now())

  @@unique([componentKey, incidentType, eventKind, eventId])
  @@index([componentKey, incidentType, processedAt])

  @@map("SystemIncidentEvent")
}

/// A browser push subscription for a staff device (the support PWA). Push
/// payloads carry only the ticket reference, never message bodies.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh      String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
