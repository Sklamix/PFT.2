generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRADER
  ADMIN
  RISK_MANAGER
}

enum KycStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum ChallengeType {
  ONE_STEP
  TWO_STEP
  FUNDED
}

enum AccountPhase {
  PHASE_1
  PHASE_2
  FUNDED
}

enum AccountStatus {
  ACTIVE
  FROZEN_STANDBY
  BREACHED
  PASSED
  PASSED_PHASE_1
  PASSED_PHASE_2
  FUNDED
  BREACHED_DAILY
  BREACHED_MAX
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum OrderSide {
  BUY
  SELL
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum PendingTradeOrderStatus {
  PENDING
  FILLED
  CANCELLED
  REJECTED
}

enum CloseReason {
  TAKE_PROFIT
  STOP_LOSS
  MANUAL
  LIQUIDATION_BREACH
}

enum PayoutStatus {
  PENDING
  APPROVED
  DISBURSED
  REJECTED
}

enum WalletNetwork {
  USDT_TRC20
  USDT_ERC20
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  passwordTokenHash      String?   @unique
  passwordTokenExpiresAt DateTime?
  name          String
  nickname      String?
  dateOfBirth   DateTime?
  phone         String?
  country       String?
  avatarUrl     String?
  emailVerifiedAt DateTime?
  profileCompletedAt DateTime?
  role          Role      @default(TRADER)
  kycStatus     KycStatus @default(UNVERIFIED)
  telegram      String?
  discord       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        TradingAccount[]
  orders          Order[]
  payouts         Payout[]
  auditLogs       AuditLog[] @relation("AuditActor")
  reviewedPayouts Payout[]   @relation("PayoutReviewer")
}

model EmailLoginCode {
  email      String   @id
  codeHash   String
  expiresAt  DateTime
  sentAt     DateTime
  attempts   Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model TradingAccount {
  id                   String         @id @default(cuid())
  displayId            String         @unique
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mt5Login             String
  mt5Server            String
  planSize             Int
  challengeType        ChallengeType
  phase                AccountPhase
  status               AccountStatus  @default(ACTIVE)
  leverage             String         @default("1:100")
  initialBalance       Decimal        @db.Decimal(14, 2)
  dailyStartingEquity  Decimal        @db.Decimal(14, 2)
  currentBalance       Decimal        @db.Decimal(14, 2)
  currentEquity        Decimal        @db.Decimal(14, 2)
  dailyDrawdownPct     Decimal        @db.Decimal(6, 3)
  maxDrawdownPct       Decimal        @db.Decimal(6, 3)
  dailyDrawdownLimitPct Decimal       @db.Decimal(6, 3)
  maxDrawdownLimitPct  Decimal        @db.Decimal(6, 3)
  profitPct            Decimal        @db.Decimal(8, 3)
  tradingDaysCount     Int            @default(0)
  profitSplitPct       Int            @default(80)
  reservedPayoutAmount Decimal        @default(0) @db.Decimal(12, 2)
  breachReason         String?
  frozenAt             DateTime?
  lastTelemetryAt      DateTime?
  balance              Float          @default(0)
  equity               Float          @default(0)
  startingBalance      Float          @default(0)
  peakEquity           Float          @default(0)
  maxDailyLoss         Float          @default(0.05)
  maxTrailingDrawdown  Float          @default(0.10)
  profitTarget         Float          @default(0.10)
  isFrozenBackup       Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  orders        Order[]
  trades        Trade[]
  payouts       Payout[]
  auditLogs     AuditLog[]
  positions     Position[]
  tradeHistory  TradeHistory[]
  pendingTradeOrders PendingTradeOrder[]

  @@index([status])
  @@index([mt5Login])
  @@index([userId])
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String?
  account          TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  provider         String      @default("cryptomus")
  providerOrderId  String      @unique
  amount           Decimal     @db.Decimal(12, 2)
  currency         String      @default("USD")
  status           OrderStatus @default(PENDING)
  rawPayload       Json?
  paymentUrl          String?
  providerInvoiceId   String?
  invoiceEmailStatus  EmailDeliveryStatus?
  invoiceEmailSentAt  DateTime?
  invoiceEmailError   String?
  provisionedAt           DateTime?
  credentialsEmailStatus  EmailDeliveryStatus?
  credentialsEmailSentAt  DateTime?
  credentialsEmailError   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
}

model Trade {
  id                    String      @id @default(cuid())
  accountId             String
  account               TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticket                String
  symbol                String
  lots                  Decimal     @db.Decimal(10, 2)
  side                  TradeSide
  openPrice             Decimal     @db.Decimal(14, 5)
  closePrice            Decimal?    @db.Decimal(14, 5)
  openTime              DateTime
  closeTime             DateTime?
  profit                Decimal     @db.Decimal(12, 2)
  swap                  Decimal     @db.Decimal(12, 2) @default(0)
  commission            Decimal     @db.Decimal(12, 2) @default(0)
  status                TradeStatus @default(OPEN)
  markedForLiquidation  Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([accountId, status])
  @@unique([accountId, ticket])
}

model Position {
  id               String         @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  symbol           String
  side             OrderSide
  sizeLots         Float
  entryPrice       Float
  currentPrice     Float
  stopLoss         Float?
  takeProfit       Float?
  floatingPnl      Float          @default(0)
  status           PositionStatus @default(OPEN)
  openedAt         DateTime       @default(now())
  closedAt         DateTime?

  @@index([tradingAccountId, status])
}

model PendingTradeOrder {
  id               String                  @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount          @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  symbol           String
  side             OrderSide
  sizeLots         Float
  limitPrice       Float
  stopLoss         Float?
  takeProfit       Float?
  status           PendingTradeOrderStatus @default(PENDING)
  reason           String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  filledAt         DateTime?
  cancelledAt      DateTime?

  @@index([tradingAccountId, status, createdAt])
  @@index([status, createdAt])
}

model TradeHistory {
  id               String         @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  symbol           String
  side             OrderSide
  sizeLots         Float
  entryPrice       Float
  exitPrice        Float
  pnl              Float
  closeReason      CloseReason
  openedAt         DateTime
  closedAt         DateTime       @default(now())

  @@index([tradingAccountId, closedAt])
}

model Payout {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String
  account          TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount           Decimal        @db.Decimal(12, 2)
  profitSplitPct   Int            @default(80)
  walletAddress    String
  network          WalletNetwork
  status           PayoutStatus   @default(PENDING)
  balanceReserved  Boolean        @default(false)
  providerBatchId  String?
  providerPayoutId String?        @unique
  providerStatus   String?
  txHash           String?
  rejectReason     String?
  requestedAt      DateTime       @default(now())
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedBy       User?          @relation("PayoutReviewer", fields: [reviewedById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  accountId String?
  account   TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model TelemetrySync {
  id             String   @id @default("global")
  lastSyncedAt   DateTime?
  lastStatus     String?
  lastError      String?
  recordsUpdated Int      @default(0)
  inProgress     Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model MarketQuote {
  symbol       String   @id
  mid          Decimal  @default(0) @db.Decimal(18, 9)
  bid          Decimal  @db.Decimal(18, 9)
  ask          Decimal  @db.Decimal(18, 9)
  spreadType   String   @default("SYNTHETIC")
  source       String   @default("TWELVE_DATA")
  providerTime DateTime
  updatedAt    DateTime @updatedAt

  @@index([providerTime])
}

model ChallengePricing {
  id            String   @id @default(cuid())
  accountSize   Int
  challengeType String   @default("2-STEP")
  dailyLossType Int
  price         Int
  updatedAt     DateTime @updatedAt

  @@unique([accountSize, challengeType, dailyLossType])
}

/// Aggregated from live spot ticks recorded by the server. One row per minute per symbol;
/// 5m/15m/1h candles are built by aggregating these rows at read time.
model GoldCandle {
  id        String   @id @default(cuid())
  symbol    String   @default("XAUUSD")
  minute    DateTime @db.Timestamptz(3)
  open      Float
  high      Float
  low       Float
  close     Float
  samples   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([symbol, minute])
  @@index([symbol, minute])
}
