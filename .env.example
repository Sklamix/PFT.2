# Leave empty to run the Operations Desk on the in-memory mock store.
# Set a Postgres URL and run `prisma db push && prisma db seed` for persistence.
DATABASE_URL=""
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
ADMIN_BOOTSTRAP_PASSWORD="PFT-Admin-Desk!"
RISK_BOOTSTRAP_PASSWORD="PFT-Risk-Desk!"
CRON_SECRET="replace-with-cron-bearer-token"
CRYPTOMUS_MERCHANT_ID=""
CRYPTOMUS_API_KEY=""
# Optional Twelve Data key for the reserve Forex price worker. Yahoo Finance is the primary
# server-side feed; this worker only fills DB quotes when Yahoo is unavailable.
TWELVE_DATA_API_KEY=""
# Market candle worker (npm run worker:market-candles). Polls the free Swissquote (gold) and
# FXCM (FX/BTC) feeds and writes one-minute candles for all tick-built symbols.
GOLD_TICK_INTERVAL_MS="5000"
# The terminal opens the signed-in trader's accounts. Without DATABASE_URL, sign in as demo@pft.local
# (password TRADER_DEMO_PASSWORD) to use the in-memory "terminal-demo" accounts.
# NOWPayments crypto checkout (https://nowpayments.io).
NOWPAYMENTS_API_KEY=
# NOWPayments Payout API account credentials (required to authenticate and create payouts).
NOWPAYMENTS_PAYOUT_EMAIL=
NOWPAYMENTS_PAYOUT_PASSWORD=
# IPN secret from NOWPayments dashboard → Payment settings; verifies x-nowpayments-sig on /api/webhooks/payment-success.
# NOWPAYMENTS_IPN_KEY is accepted as a legacy alias. Required in production.
NOWPAYMENTS_IPN_SECRET=
# Resend transactional email (https://resend.com). Without a key, invoice emails are skipped.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "PFT Challenges <billing@yourdomain.com>".
RESEND_FROM_EMAIL=
# Public base URL used in emailed links (terminal access link). Defaults to the current Vercel deployment.
NEXT_PUBLIC_APP_URL=
# Server name shown on provisioned challenge accounts (default PFT-Demo-Server).
PFT_TRADING_SERVER=
# Signs trader login cookies (falls back to ADMIN_SESSION_SECRET). Use 16+ random characters.
TRADER_SESSION_SECRET=
# Password for demo@pft.local when running without DATABASE_URL (default PFT-Demo-Trader!).
TRADER_DEMO_PASSWORD=
# Didit KYC. API key is server-side only. Configure https://<app>/api/kyc/webhook
# as a Didit webhook destination and paste its secret_shared_key below.
DIDIT_API_KEY=""
DIDIT_WEBHOOK_SECRET=""
# Optional. If omitted, the app picks the first published KYC workflow from Didit.
DIDIT_WORKFLOW_ID=""
# Auth.js secret (use a unique random value of at least 32 bytes in production).
AUTH_SECRET=
# Google OAuth credentials. Configure the OAuth redirect URI as https://<host>/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI provider switch: nvidia | gemini. If empty, NVIDIA is used when NVIDIA_API_KEY
# is set, otherwise Gemini. Rollback = change this value, no code change.
AI_PROVIDER=
# NVIDIA Build (NIM) — server-side only; never expose to the browser.
NVIDIA_API_KEY=
# OpenAI-compatible base URL (default: https://integrate.api.nvidia.com/v1)
NVIDIA_BASE_URL=
# Optional model override (default: nvidia/nemotron-3.5-lightning-30b-a3b)
NVIDIA_MODEL=

# Google Gemini (server-side only; never expose to the browser)
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=
